# 复制为 .env。不要把真实密钥提交进仓库。
# mock：不访问网络，测试和 make demo 用这个。
# live：向 OPENAI_BASE_URL/chat/completions 发请求，DeepSeek 与 SiliconFlow 都是这个协议。

LLM_MODE=mock
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=

# 示例模型名，不是报价，也不是必须使用的型号。
CHEAP_MODEL=deepseek-ai/DeepSeek-V3
STRONG_MODEL=Qwen/Qwen2.5-72B-Instruct

# 单次图运行的 token 上限。超限走预算早停，而不是继续调用。
MAX_TOKENS_PER_RUN=8000
OUTPUT_RESERVE_TOKENS=80

AUDIT_DIR=var/audit
RATE_LIMIT_PER_MIN=60
REQUEST_TIMEOUT_S=30
MAX_REVISIONS=1
MAX_REVIEW_ROUNDS=2
